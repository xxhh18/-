<!DOCTYPE html>
<html lang="lx">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#050a20" />
<title>中秋快乐</title>
<audio src="陈慧娴 - 千千阕歌.mp3" autoplay loop></audio>  
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; margin: 0; }
  body {
    font-family: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    color: #fff;
    background: radial-gradient(120% 80% at 50% 0%, #1b2350 0%, #0d1330 45%, #050a20 100%);
    overflow: hidden;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ---------- 星空 ---------- */
  #stars, #petals { position: fixed; inset: 0; pointer-events: none; }
  .star {
    position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: #fff; opacity: .8;
    animation: twinkle 3s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: .15; transform: scale(.7); }
    50%      { opacity: .95; transform: scale(1.2); }
  }
  .petal {
    position: absolute; top: -5%;
    width: 4px; height: 4px; border-radius: 50%;
    background: radial-gradient(circle, #ffe9a8, rgba(255,201,102,0));
    animation: fall linear infinite;
  }
  @keyframes fall {
    0%   { transform: translateY(0) translateX(0); opacity: 0; }
    10%  { opacity: .9; }
    100% { transform: translateY(110vh) translateX(40px); opacity: 0; }
  }

  /* ---------- 月亮 ---------- */
  .sky {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 2;
  }
  .moon-wrap {
    position: relative;
    width: min(56vw, 230px);
    aspect-ratio: 1;
    cursor: pointer;
    transition: transform .5s cubic-bezier(.34,1.56,.64,1);
  }
  .moon-wrap:active { transform: scale(.94); }
  .moon-wrap.lit { transform: scale(1.06); }
  .halo {
    position: absolute; inset: -38%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,231,160,.45) 0%, rgba(255,214,120,.18) 38%, rgba(255,214,120,0) 70%);
    animation: breathe 5s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { transform: scale(.94); opacity: .8; }
    50%      { transform: scale(1.06); opacity: 1; }
  }
  .moon {
    position: absolute; inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 30%, #fffdf2 0%, #ffeeb8 42%, #f6d275 72%, #e6ba55 100%);
    box-shadow:
      0 0 30px rgba(255,232,160,.75),
      0 0 90px rgba(255,210,110,.45),
      inset -14px -12px 34px rgba(206,150,40,.45);
  }
  .crater {
    position: absolute; border-radius: 50%;
    background: rgba(214,166,70,.4);
    box-shadow: inset 2px 2px 5px rgba(168,120,30,.35);
  }
  .c1 { width: 20%; height: 20%; top: 24%; left: 27%; }
  .c2 { width: 13%; height: 13%; top: 52%; left: 22%; }
  .c3 { width: 16%; height: 16%; top: 40%; left: 58%; }
  .c4 { width: 9%;  height: 9%;  top: 68%; left: 55%; }

  /* 玉兔 */
  .rabbit {
    position: absolute; bottom: 6%; right: 8%;
    font-size: min(11vw, 46px);
    filter: drop-shadow(0 0 8px rgba(255,240,190,.9));
    animation: hop 2.6s ease-in-out infinite;
    transform-origin: center bottom;
  }
  @keyframes hop {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    40%      { transform: translateY(-14%) rotate(4deg); }
  }

  /* ---------- 灯笼 ---------- */
  .lantern {
    position: fixed; top: 0;
    transform-origin: top center;
    animation: swing 4s ease-in-out infinite;
    z-index: 3;
  }
  .lantern .line { width: 1px; height: 46px; margin: 0 auto; background: linear-gradient(#ffd98a, rgba(255,217,138,.2)); }
  .lantern .body {
    width: 46px; height: 58px; border-radius: 50% / 42%;
    background: radial-gradient(circle at 35% 30%, #ff8a6a, #e33b3b 60%, #b31f26 100%);
    box-shadow: 0 0 22px rgba(255,110,90,.85), inset 0 0 12px rgba(255,230,180,.6);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #ffeec2; font-weight: 700;
    animation: glow 2.4s ease-in-out infinite;
  }
  .lantern .tail { width: 3px; height: 14px; margin: 0 auto; background: linear-gradient(#ffd98a, rgba(255,217,138,0)); }
  @keyframes swing {
    0%, 100% { transform: rotate(-7deg); }
    50%      { transform: rotate(7deg); }
  }
  @keyframes glow { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.25); } }

  /* ---------- 文字 ---------- */
  .title {
    margin: 14px 0 2px;
    font-size: clamp(34px, 13vw, 60px);
    font-weight: 800;
    letter-spacing: .12em;
    background: linear-gradient(180deg, #fffef4 0%, #ffe7a3 55%, #f0b93f 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 18px rgba(255,214,120,.6));
  }
  .sub { font-size: 13px; letter-spacing: .38em; color: rgba(255,236,190,.68); }
  .wish {
    margin-top: 16px; min-height: 26px;
    font-size: 15px; line-height: 1.6; text-align: center;
    color: #ffeecc; text-shadow: 0 0 12px rgba(255,200,110,.5);
    animation: fadeUp .6s ease both;
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ---------- 按钮 ---------- */
  .bar {
    width: 100%; padding: 0 22px 26px;
    display: flex; gap: 12px; justify-content: center;
    z-index: 4;
  }
  .btn {
    flex: 1 1 0; max-width: 170px;
    padding: 12px 10px; border: 1px solid rgba(255,214,120,.45); border-radius: 999px;
    background: linear-gradient(180deg, rgba(255,222,150,.20), rgba(255,190,80,.08));
    color: #ffeec2; font-size: 14px; font-weight: 600; letter-spacing: .08em;
    backdrop-filter: blur(6px);
    transition: transform .15s, box-shadow .3s;
  }
  .btn:active { transform: scale(.95); box-shadow: 0 0 22px rgba(255,205,110,.5); }
  .btn[disabled] { opacity: .5; }

  .mooncake-row { display: flex; gap: 18px; font-size: 24px; margin-top: 12px; opacity: .9; }
  .mooncake-row span { animation: hop 3.4s ease-in-out infinite; }
  .mooncake-row span:nth-child(2) { animation-delay: .4s; }
  .mooncake-row span:nth-child(3) { animation-delay: .8s; }

  /* 点击月亮时的星星迸发 */
  .spark {
    position: fixed; width: 6px; height: 6px; border-radius: 50%;
    background: #fff6cf; pointer-events: none; z-index: 5;
    box-shadow: 0 0 10px #ffe08a;
  }
</style>
</head>
<body>
  <div id="stars"></div>
  <div id="petals"></div>

  <div class="sky">
    <div class="moon-wrap" id="moonWrap">
      <div class="halo"></div>
      <div class="moon">
        <i class="crater c1"></i><i class="crater c2"></i>
        <i class="crater c3"></i><i class="crater c4"></i>
        <span class="rabbit">🐰</span>
      </div>
    </div>
    <h1 class="title">中秋快乐</h1>
    <div class="sub">但 愿 人 长 久</div>
    <div class="wish" id="wish"> 良辰美景，皓月当空，愿你平安喜乐，所得皆欢喜🌕</div>
    <div class="mooncake-row"><span>🥮</span><span>🏮</span><span>🌕</span></div>
  </div>

  <div class="bar">
    <button class="btn" id="btnWish">换个祝福</button>
    <button class="btn" id="btnShare">分享祝福</button>
  </div>

<script>
(function () {
  /* -------- 星空 -------- */
  var stars = document.getElementById('stars');
  for (var i = 0; i < 70; i++) {
    var s = document.createElement('div');
    s.className = 'star';
    s.style.left = Math.random() * 100 + '%';
    s.style.top = Math.random() * 70 + '%';
    var size = Math.random() * 2 + 1;
    s.style.width = s.style.height = size + 'px';
    s.style.animationDelay = (Math.random() * 3).toFixed(2) + 's';
    stars.appendChild(s);
  }

  /* -------- 飘落光点 -------- */
  var petals = document.getElementById('petals');
  for (var j = 0; j < 22; j++) {
    var p = document.createElement('div');
    p.className = 'petal';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (6 + Math.random() * 7).toFixed(1) + 's';
    p.style.animationDelay = (-Math.random() * 12).toFixed(1) + 's';
    var sz = (2 + Math.random() * 4).toFixed(1);
    p.style.width = p.style.height = sz + 'px';
    petals.appendChild(p);
  }

  /* -------- 灯笼 -------- */
  ['中', '秋'].forEach(function (ch, idx) {
    var l = document.createElement('div');
    l.className = 'lantern';
    l.style[idx === 0 ? 'left' : 'right'] = '12px';
    l.style.top = idx === 0 ? '-8px' : '-2px';
    l.style.animationDelay = (idx * 0.9) + 's';
    l.innerHTML = '<div class="line"></div><div class="body">' + ch + '</div><div class="tail"></div>';
    document.body.appendChild(l);
  });

  /* -------- 祝福语 -------- */
  var wishes = [
    '海上生明月，天涯共此时 🌊',
    '但愿人长久，千里共婵娟 🌕',
    '一轮圆月，照亮归途，也照亮思念 🏡',
    '月饼要分着吃，才够甜 🥮',
    '桂花香里话团圆，清风明月伴平安 🍃',
    '月圆人圆事事圆，中秋佳节乐无边 🏮',
    '今夜月色真美，愿你喜乐无忧 ✨',
    '送你一轮明月，装满我的祝福 💫'
  ];
  var wishEl = document.getElementById('wish');
  var last = -1;
  function nextWish() {
    var i;
    do { i = Math.floor(Math.random() * wishes.length); } while (wishes.length > 1 && i === last);
    last = i;
    wishEl.textContent = wishes[i];
    wishEl.style.animation = 'none';
    void wishEl.offsetWidth;
    wishEl.style.animation = 'fadeUp .6s ease both';
    return wishes[i];
  }

  /* -------- 星星迸发 -------- */
  function burst() {
    var r = document.getElementById('moonWrap').getBoundingClientRect();
    var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    for (var k = 0; k < 16; k++) {
      (function (k) {
        var sp = document.createElement('div');
        sp.className = 'spark';
        sp.style.left = cx + 'px';
        sp.style.top = cy + 'px';
        document.body.appendChild(sp);
        var ang = Math.random() * Math.PI * 2;
        var dist = 70 + Math.random() * 130;
        sp.animate([
          { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 },
          { transform: 'translate(' + (Math.cos(ang) * dist - 3) + 'px,' + (Math.sin(ang) * dist - 3) + 'px) scale(0)', opacity: 0 }
        ], { duration: 700 + Math.random() * 500, easing: 'cubic-bezier(.2,.7,.4,1)' }).onfinish = function () {
          sp.remove();
        };
      })(k);
    }
  }

  var moonWrap = document.getElementById('moonWrap');
  moonWrap.addEventListener('click', function () {
    moonWrap.classList.add('lit');
    setTimeout(function () { moonWrap.classList.remove('lit'); }, 600);
    burst();
    nextWish();
    vibrate(18);
  });

  /* -------- 原生能力（可选，不存在时自动降级） -------- */
  function withWebcat(cb) {
    if (window.webcat) return cb(window.webcat);
    var n = 0, t = setInterval(function () {
      if (window.webcat) { clearInterval(t); cb(window.webcat); }
      else if (++n > 40) { clearInterval(t); }
    }, 50);
  }
  function vibrate(ms) {
    try { if (navigator.vibrate) navigator.vibrate(ms); } catch (e) {}
  }

  document.getElementById('btnWish').addEventListener('click', function () {
    nextWish();
    vibrate(12);
  });

  var btnShare = document.getElementById('btnShare');
  btnShare.addEventListener('click', function () {
    var text = '🌕 中秋快乐！\n' + wishEl.textContent.replace(/[\u{1F300}-\u{1FAFF}\u2600-\u27BF]/gu, '').trim() +
               '\n—— 愿你月圆人团圆，中秋安康 🏮';
    var done = function (tip) {
      withWebcat(function (webcat) {
        if (webcat.ui && webcat.ui.toast) webcat.ui.toast(tip);
        else alert(tip);
      });
    };
    var fallback = function () {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { done('祝福已复制，去粘贴给朋友吧～'); },
                                                  function () { done(text); });
      } else { done(text); }
    };
    btnShare.disabled = true;
    withWebcat(function (webcat) {
      var fire = function () {
        if (webcat.share && webcat.share.text) {
          Promise.resolve(webcat.share.text(text)).then(function () {
            btnShare.disabled = false;
          }, function () { btnShare.disabled = false; fallback(); });
        } else { btnShare.disabled = false; fallback(); }
      };
      if (webcat.share && webcat.share.text) fire();
      else setTimeout(function () { btnShare.disabled = false; fallback(); }, 600);
    });
  });
})();
</script>
</body>
</html>
